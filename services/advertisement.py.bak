import asyncio
from datetime import timedelta
from aiogram import Bot
from aiogram.exceptions import TelegramForbiddenError, TelegramRetryAfter
from sqlalchemy import select, or_
from sqlalchemy.orm import selectinload
from database import AsyncSessionLocal, NFT, NFTStatus, AdLog, Group, utcnow
from keyboards.inline import get_ad_kb
from services.utils import fmt_price, time_left, esc, commission_pct
from config import config


async def delete_nft_ads(bot: Bot, nft_id: int):
    async with AsyncSessionLocal() as session:
        res = await session.execute(select(AdLog).where(AdLog.nft_id == nft_id))
        logs = res.scalars().all()
        for log in logs:
            try:
                await bot.delete_message(chat_id=log.group_id, message_id=log.message_id)
            except Exception:
                pass
            await session.delete(log)
        await session.commit()


def build_ad_text(nft: NFT, seller, bot_username: str) -> str:
    if seller and seller.username:
        name = f"@{esc(seller.username)}"
    else:
        name = esc(seller.full_name if seller else "—")
    return (
        "🖼 <b>NFT SOTUVDA</b>\n\n"
        f"🔗 {nft.nft_link}\n"
        f"💰 <b>Narx:</b> {fmt_price(nft.price, nft.currency.value)} {nft.currency.value}\n"
        f"👤 <b>Sotuvchi:</b> {name}\n"
        f"👁 <b>Bosildi:</b> {nft.clicks}\n"
        f"⏳ <b>Qoldi:</b> {time_left(nft.expires_at)}\n\n"
        f"➕ NFT qo'yish uchun botga yozing: @{bot_username}\n"
        f"🤝 NFT olish-sotishda yordam uchun: @{config.PLATFORM_ADMIN_USERNAME} | 💸 Komissiya: {commission_pct()}%"
    )


async def _send_ad(bot: Bot, session, nft: NFT, groups, bot_username: str, now):
    await delete_nft_ads(bot, nft.id)
    text = build_ad_text(nft, nft.seller, bot_username)
    kb = get_ad_kb(nft.id, bot_username)
    for g in groups:
        if not g.is_active:
            continue
        try:
            msg = await bot.send_message(g.chat_id, text, reply_markup=kb, disable_web_page_preview=False)
            session.add(AdLog(nft_id=nft.id, group_id=g.chat_id, message_id=msg.message_id))
        except TelegramRetryAfter as e:
            await asyncio.sleep(e.retry_after)
        except TelegramForbiddenError:
            g.is_active = False
            print(f"[AD] Guruh o'chirildi (bot chiqarib yuborilgan): {g.chat_id}")
        except Exception as e:
            print(f"[AD ERROR] NFT {nft.id} -> {g.chat_id}: {e}")
        await asyncio.sleep(0.4)
    nft.last_ad_sent_at = now
    await session.commit()


async def post_nft_now(bot: Bot, nft_id: int):
    """Admin tasdiqlagandan keyin NFT ni darhol guruhlarga yuboradi."""
    async with AsyncSessionLocal() as session:
        res = await session.execute(
            select(NFT).options(selectinload(NFT.seller)).where(NFT.id == nft_id)
        )
        nft = res.scalar_one_or_none()
        if not nft or nft.status != NFTStatus.ACTIVE:
            return
        groups = (await session.execute(select(Group).where(Group.is_active == True))).scalars().all()  # noqa: E712
        if not groups:
            print("[AD] Ulangan guruh yo'q. Guruhda /addgroup deb yozing.")
            return
        bot_username = (await bot.get_me()).username
        await _send_ad(bot, session, nft, groups, bot_username, utcnow())


async def process_ad_job(bot: Bot):
    now = utcnow()

    # 1) Muddati tugaganlarni yopish
    async with AsyncSessionLocal() as session:
        res = await session.execute(
            select(NFT).where(NFT.status == NFTStatus.ACTIVE, NFT.expires_at <= now)
        )
        expired = res.scalars().all()
        expired_info = [(n.id, n.seller_id) for n in expired]
        for n in expired:
            n.status = NFTStatus.EXPIRED
        await session.commit()

    for nft_id, seller_id in expired_info:
        await delete_nft_ads(bot, nft_id)
        try:
            await bot.send_message(
                seller_id,
                f"⌛ NFT #{nft_id} muddati ({config.EXPIRATION_DAYS} kun) tugadi va reklamadan olindi.",
            )
        except Exception:
            pass

    # 2) Har 10 daqiqada qayta reklama
    async with AsyncSessionLocal() as session:
        groups = (await session.execute(select(Group).where(Group.is_active == True))).scalars().all()  # noqa: E712
        if not groups:
            print("[AD] Ulangan guruh yo'q. Guruhda /addgroup deb yozing.")
            return

        threshold = now - timedelta(minutes=config.AD_INTERVAL_MINUTES)
        res = await session.execute(
            select(NFT)
            .options(selectinload(NFT.seller))
            .where(
                NFT.status == NFTStatus.ACTIVE,
                or_(NFT.last_ad_sent_at.is_(None), NFT.last_ad_sent_at <= threshold),
            )
            .order_by(NFT.id)
        )
        nfts = res.scalars().all()
        if not nfts:
            return

        bot_username = (await bot.get_me()).username
        for nft in nfts:
            await _send_ad(bot, session, nft, groups, bot_username, now)
