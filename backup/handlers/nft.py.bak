import re
from decimal import Decimal
from aiogram import Router, F, Bot
from aiogram.types import Message, CallbackQuery
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import StatesGroup, State
from sqlalchemy import select, func
from database import AsyncSessionLocal, User, NFT, Currency, NFTStatus
from keyboards.inline import get_currency_kb, get_admin_approval_kb, get_my_nft_kb
from services.nft_service import NFTService
from services.advertisement import delete_nft_ads
from services.utils import fmt_price, time_left, esc
from config import config

router = Router()
router.message.filter(F.chat.type == "private")

LINK_RE = re.compile(r"^(?:https?://)?t\.me/nft/[A-Za-z0-9_\-]+$", re.I)


class NFTCreation(StatesGroup):
    waiting_media = State()
    link = State()
    currency = State()
    price = State()


def norm_link(text: str) -> str:
    text = text.strip()
    if not text.lower().startswith("http"):
        text = "https://" + text
    return text


async def begin_sell(message: Message, state: FSMContext):
    uid = message.from_user.id
    if not message.from_user.username:
        await message.answer(
            "❗️ Avval Telegram sozlamalarida <b>username</b> o'rnating (Settings → Username), "
            "keyin qayta urinib ko'ring. Xaridorlar siz bilan shu orqali bog'lanadi."
        )
        return
    async with AsyncSessionLocal() as session:
        user = await session.get(User, uid)
        if user and user.is_banned:
            await message.answer("🚫 Siz bloklangansiz.")
            return
        err = await NFTService.check_can_post(session, uid)
    if err:
        await message.answer(err)
        return
    await state.set_state(NFTCreation.link)

    await message.answer(
        "📋 <b>NFT sotish tartibi</b>\n\n"
        f"1️⃣ Avval 15 ta NFT GIF/rasmni @{config.PLATFORM_ADMIN_USERNAME} ga yuboring.\n"
        "2️⃣ Admin NFTlaringizni tekshiradi va tasdiqlaydi.\n\n"
        "⏳ Admin tasdig‘ini kuting.",
        parse_mode="HTML"
    )


@router.message(NFTCreation.waiting_media, F.photo)
async def receive_nft_photo(message: Message, state: FSMContext, bot: Bot):
    data = await state.get_data()
    count = data.get("media_count", 0)

    if count >= 15:
        await message.answer("✅ 15 ta NFT qabul qilindi. Admin tasdig‘ini kuting.")
        return

    try:
        await bot.send_photo(
            chat_id=f"@{config.PLATFORM_ADMIN_USERNAME}",
            photo=message.photo[-1].file_id,
            caption=(
                f"🖼 <b>NFT #{count + 1}/15</b>\n\n"
                f"👤 Foydalanuvchi: @{message.from_user.username or 'username yo‘q'}\n"
                f"🆔 ID: <code>{message.from_user.id}</code>"
            ),
            parse_mode="HTML"
        )

        count += 1
        await state.update_data(media_count=count)

        if count < 15:
            await message.answer(
                f"✅ NFT #{count}/15 qabul qilindi.\n"
                f"📸 Yana {15 - count} ta NFT GIF/rasm yuboring."
            )
        else:
            await message.answer(
                "✅ 15 ta NFT qabul qilindi.\n\n"
                "⏳ Admin NFTlaringizni tekshiradi va tasdiqlaydi."
            )

    except Exception as e:
        print(f"ADMIN NFT SEND ERROR: {e}")
        await message.answer(
            "❌ NFTni adminga yuborishda xatolik yuz berdi."
        )


